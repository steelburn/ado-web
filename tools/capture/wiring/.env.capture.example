# Capture-harness secrets + endpoints. Copy to tools/capture/.env.capture (gitignored).
#
# Defaults below point at the LOCAL MOCKS, so the harness runs with no secrets and
# produces byte-stable screenshots in CI. To shoot against a real organization,
# replace ADO_* and LLM_* with live values (the PAT/API key never get committed).

# --- Azure DevOps (demo org) ---
ADO_ORG=contoso-demo
ADO_ORG_URL=http://ado-mock:9000
ADO_PROJECT=AdoDemo
ADO_PAT=local-mock-pat

# --- LLM (OpenAI-compatible) ---
LLM_PROVIDER=openai
LLM_API_URL=http://llm-mock:9001/v1
LLM_API_KEY=local-mock-key
LLM_MODEL=demo-gpt

# --- behaviour ---
ADO_CODE_MODE=agent
